  "safety_eula1Title": "1. Đồng ý điều khoản",
  "@safety_eula1Title": {
    "description": "EULA section heading."
  },
  "safety_eula1Body": "Khi tạo tài khoản hoặc dùng Ourney, bạn đồng ý với các điều khoản này. Nếu không đồng ý, vui lòng không sử dụng ứng dụng.",
  "@safety_eula1Body": {
    "description": "EULA section body."
  },
  "safety_eula2Title": "2. Không dung thứ nội dung phản cảm",
  "@safety_eula2Title": {
    "description": "EULA section heading."
  },
  "safety_eula2Body": "Ourney không chấp nhận bất kỳ nội dung phản cảm hay người dùng lạm dụng nào. Bạn không được đăng hoặc gửi: ảnh khoả thân, khiêu dâm; nội dung quấy rối, bắt nạt, đe doạ; phát ngôn thù ghét hoặc phân biệt đối xử; bạo lực; nội dung cổ vũ tự làm hại bản thân; spam, lừa đảo; nội dung vi phạm pháp luật hoặc quyền của người khác.",
  "@safety_eula2Body": {
    "description": "EULA section body: zero tolerance."
  },
  "safety_eula3Title": "3. Nội dung của bạn",
  "@safety_eula3Title": {
    "description": "EULA section heading."
  },
  "safety_eula3Body": "Ảnh, chú thích và số liệu bạn đăng vẫn thuộc về bạn. Bạn cho phép Ourney lưu trữ và hiển thị chúng cho những người bạn chọn chia sẻ (thành viên nhóm, người có link công khai). Bạn chịu trách nhiệm về nội dung mình đăng.",
  "@safety_eula3Body": {
    "description": "EULA section body."
  },
  "safety_eula4Title": "4. Báo cáo, chặn và kiểm duyệt",
  "@safety_eula4Title": {
    "description": "EULA section heading."
  },
  "safety_eula4Body": "Bạn có thể báo cáo check-in hoặc người dùng và chặn bất kỳ ai. Chúng mình xem xét báo cáo trong vòng 24 giờ, gỡ nội dung vi phạm và khoá tài khoản của người vi phạm.",
  "@safety_eula4Body": {
    "description": "EULA section body."
  },
  "safety_eula5Title": "5. Chấm dứt",
  "@safety_eula5Title": {
    "description": "EULA section heading."
  },
  "safety_eula5Body": "Chúng mình có thể tạm khoá hoặc xoá tài khoản vi phạm các điều khoản này mà không cần báo trước. Bạn có thể xoá tài khoản bất cứ lúc nào trong Hồ sơ.",
  "@safety_eula5Body": {
    "description": "EULA section body."
  },
  "safety_eula6Title": "6. Miễn trừ và thay đổi",
  "@safety_eula6Title": {
    "description": "EULA section heading."
  },
  "safety_eula6Body": "Ourney được cung cấp \"như hiện có\" và không thay thế lời khuyên y tế, dinh dưỡng hay tập luyện chuyên môn. Khi điều khoản thay đổi, chúng mình sẽ thông báo trong ứng dụng.",
  "@safety_eula6Body": {
    "description": "EULA section body."
  },

  "safety_privacy1Title": "Chúng mình lưu gì",
  "@safety_privacy1Title": {
    "description": "Privacy section heading."
  },
  "safety_privacy1Body": "Email (để đăng nhập); tên hiển thị, username và ảnh đại diện; hành trình bạn tạo; check-in gồm ảnh, chú thích, số liệu (ví dụ cân nặng) và thời điểm chụp; reaction; báo cáo và danh sách chặn của bạn.",
  "@safety_privacy1Body": {
    "description": "Privacy section body: data stored."
  },
  "safety_privacy2Title": "Ai thấy được",
  "@safety_privacy2Title": {
    "description": "Privacy section heading."
  },
  "safety_privacy2Body": "Hành trình riêng tư chỉ mình bạn thấy. Hành trình nhóm chỉ thành viên nhóm thấy. Link công khai chỉ hiện những gì bạn bật, và bạn có thể ẩn số liệu hoặc làm mờ ảnh. Ở chế độ chỉ trên máy, dữ liệu không rời khỏi điện thoại.",
  "@safety_privacy2Body": {
    "description": "Privacy section body: who can see."
  },
  "safety_privacy3Title": "Chúng mình không làm gì",
  "@safety_privacy3Title": {
    "description": "Privacy section heading."
  },
  "safety_privacy3Body": "Không bán dữ liệu của bạn. Không quảng cáo. Không dùng ảnh của bạn cho mục đích nào khác ngoài hiển thị trong Ourney.",
  "@safety_privacy3Body": {
    "description": "Privacy section body: no selling."
  },
  "safety_privacy4Title": "Thông báo",
  "@safety_privacy4Title": {
    "description": "Privacy section heading."
  },
  "safety_privacy4Body": "Lời nhắc check-in là thông báo cục bộ, được lên lịch ngay trên máy bạn.",
  "@safety_privacy4Body": {
    "description": "Privacy section body: notifications."
  },
  "safety_privacy5Title": "Xoá dữ liệu",
  "@safety_privacy5Title": {
    "description": "Privacy section heading."
  },
  "safety_privacy5Body": "Vào Hồ sơ > Xoá tài khoản để xoá vĩnh viễn tài khoản, mọi check-in và ảnh của bạn trên máy chủ. Nếu bạn là chủ nhóm, quyền chủ nhóm được chuyển cho thành viên tham gia sớm nhất.",
  "@safety_privacy5Body": {
    "description": "Privacy section body: deletion."
  },
  "safety_privacy6Title": "Liên hệ",
  "@safety_privacy6Title": {
    "description": "Privacy section heading."
  },
  "safety_privacy6Body": "Có câu hỏi về quyền riêng tư? Xem trang Liên hệ trong mục An toàn & hỗ trợ.",
  "@safety_privacy6Body": {
    "description": "Privacy section body: contact."
  }

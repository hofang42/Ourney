<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_initial_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_card_initial"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="14dp">

    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_ourney_sticker_flame" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:includeFontPadding="true"
        android:lineSpacingMultiplier="1.35"
        android:text="@string/widget_loading"
        android:textColor="@color/widget_ink"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:includeFontPadding="true"
        android:lineSpacingMultiplier="1.35"
        android:text="@string/widget_loading_subtitle"
        android:textColor="@color/widget_ink_muted"
        android:textSize="11sp" />
</LinearLayout>
